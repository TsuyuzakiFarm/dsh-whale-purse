{
  "name": "dsh-whale-purse",
  "description": "鲸鱼娘桌宠 · DeepSeek 余额 + 会话用量/花费监视（DSH 组合包：cordis.patch.yml 层 + Web 客户端 bundle）",
  "version": "0.2.2",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "scripts",
    "assets/whale-sprite.webp",
    "README.md",
    "ADAPTATION.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.5-rc.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.1.7-rc.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node scripts/smoke-test.mjs && node scripts/plugin-test.mjs",
    "embed": "node scripts/embed-asset.mjs",
    "screenshot": "node scripts/screenshot.mjs"
  },
  "keywords": [
    "deepseek",
    "dsh",
    "whale",
    "balance",
    "usage",
    "desktop-pet",
    "cordis"
  ],
  "license": "MIT",
  "author": "TsuyuzakiMahiru <jingyee1900@live.cn>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TsuyuzakiFarm/dsh-whale-purse.git"
  },
  "homepage": "https://github.com/TsuyuzakiFarm/dsh-whale-purse#readme",
  "bugs": {
    "url": "https://github.com/TsuyuzakiFarm/dsh-whale-purse/issues"
  }
}
